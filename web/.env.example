# This is environment variables file for development. You can copy this file to .env and change the values as needed.

# Define backend url here. Defaults to 8000 for local development
# Please update this value if your backend is running on remote server or different port
VITE_BACKEND_URL=http://localhost:8000


# Note: This is not needed if you set it up via convex cli, however we put it here for reference and other who prefers manual way.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Configure this in a secure way as it is used to verify the authenticity of the user. You could generate this using "openssl rand -hex 32" in terminal or as long as it is 32 characters.
BETTER_AUTH_SECRET=

# A comma-separated list of trusted external origins allowed for redirects (e.g., https://anotherapp.com,https://yetanotherapp.com)
VITE_TRUSTED_ORIGINS=