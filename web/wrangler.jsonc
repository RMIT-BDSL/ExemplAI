{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exemplai",
  "compatibility_date": "2026-06-27",
  "observability": {
    "enabled": true
  },
  "main": "@tanstack/react-start/server-entry",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "preview": {
      "name": "exemplai-preview"
    },
    "dev": {
      "name": "exemplai-dev"
    }
  }
}
