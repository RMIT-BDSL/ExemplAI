JUDGE0_ENDPOINT=
JUDGE0_AUTH_KEY=

# configure sentry endpoint here
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
# For who uses RapidAPI, also configure the following:
# determine whether or not to use rapidapi (case-sensitive - True/False)
IS_RAPIDAPI=
RAPIDAPI_KEY=

# RapidAPI endpoint should only contain the domain name - excluding the http:// or alike (for example, google.com instead of https://google.com).
RAPIDAPI_HOST=
# OpenAI API key — only used if OPENROUTER_ENABLED is set to False (fallback).
OPENAI_API_KEY=

# OpenRouter (OpenAI-compatible) is the agent's LLM route by default. Supply a
# key (https://openrouter.ai), OPENROUTER_MODEL defaults to DeepSeek V4.1
# Flash. Set OPENROUTER_ENABLED=False to fall back to OpenAI above.
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=True
# Leave OPENROUTER_* settings unset to use the defaults in config.py. An empty
# value (OPENROUTER_MODEL=) is NOT the default: it's an empty model name.
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Speed settings (defaults in config.py): provider order (throughput / latency
# / price, empty = OpenRouter's cheapest-first default), reasoning effort and
# output caps for the reply agents and for the guardrail/Dean checks, and an
# optional separate model for the checks.
# OPENROUTER_PROVIDER_SORT=throughput
# OPENROUTER_REQUIRE_PARAMETERS=True
# OPENROUTER_AGENT_REASONING=low
# OPENROUTER_CHECK_REASONING=low
# OPENROUTER_AGENT_MAX_TOKENS=16384
# OPENROUTER_CHECK_MAX_TOKENS=8192
# OPENROUTER_CHECK_MODEL=openai/gpt-oss-120b

# Runnable code blocks in the tutor chat (web: VITE_RUNNABLE_CHAT_CODE). When
# False, the Erroneous tutor doesn't tell students to edit the example and press Run.
RUNNABLE_CHAT_CODE=False

# Convex deployment URL for securing backend routes
CONVEX_URL=
CONVEX_BACKEND_SECRET=